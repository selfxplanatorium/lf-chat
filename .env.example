# Authentication requires a backend server.
# JWT secret - change this to a random secure value in production
JWT_SECRET=change-this-to-a-random-secret-in-production

# Application URL — used in password reset emails AND as the CORS origin allowlist
APP_URL=http://localhost:3000

# Allow new account registration. Set to false when reverse-proxying and
# exposing LF CHAT to the public internet so strangers can't self-register.
# Default is true (so the first user can bootstrap a fresh install). Existing
# accounts can always sign in regardless of this setting.
#
# This is only the DEFAULT. Once an admin toggles registration in Settings the
# choice is stored in the database and wins over this variable, so editing it
# here afterwards has no effect. Delete the `allow_signups` row from the
# `app_config` table to hand control back to this variable.
ALLOW_SIGNUPS=true

# Email configuration (SMTP)
EMAIL_SMTP=true
EMAIL_SMTP_HOST=your-smtp-host.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=your-smtp-user
EMAIL_SMTP_PASSWORD=your-smtp-password
EMAIL_SMTP_USE_SSL=true
FROM_EMAIL=noreply@your-domain.com